" Vanilla baseline — no longer the primary editor; re-tailor here if that changes.
set nocompatible
syntax on
filetype plugin indent on

set number
set incsearch
set hlsearch
set expandtab
set shiftwidth=2
set tabstop=2
set autoindent

" Yank/delete/put go through the system clipboard. Guarded because Vim
" builds without +clipboard reject the option, and Neovim reports no
" clipboard until it finds a provider (pbcopy on macOS, wl-copy/xclip on
" Linux, e.g. the wl-clipboard package).
if has('clipboard')
  set clipboard=unnamedplus
endif
